# ---------------------------------------------------------------
# Unity-generated files and folders
# (this project has no Unity project yet - these rules are in place
#  so that the first Unity commit does not drag generated files in)
# ---------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data for files that are ignored
!/[Aa]ssets/**/*.meta

# Unity Package Manager / Addressables / Burst artefacts
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/[Pp]lugins/[Aa]ndroid/*.aar

# Autogenerated project / solution files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash reports
sysinfo.txt
crashlytics-build.properties

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Never commit signing material (Session 7: lose it and you cannot
# update the app; commit it and anyone can sign as you)
*.keystore
*.jks
*.p12
*.mobileprovision
keystore.properties

# ---------------------------------------------------------------
# Operating-system clutter
# ---------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------
.vs/
.vscode/
.idea/
*.swp
*~

# ---------------------------------------------------------------
# Credentials and local secrets
# ---------------------------------------------------------------
.env
.env.*
*.pem
*.key
secrets.json
credentials.json

# ---------------------------------------------------------------
# Local AI-tool configuration
# (Session 7: commit the game, not the agent's toolbox)
# ---------------------------------------------------------------
.claude/
.cursor/
.windsurf/
.aider*
.github/copilot-instructions.md
CLAUDE.local.md
.mcp.json
